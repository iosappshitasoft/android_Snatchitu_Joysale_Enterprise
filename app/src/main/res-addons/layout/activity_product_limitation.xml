<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context="com.ni.addons.productlimit.ProductLimitation">



    <include
        android:id="@+id/actionbar"
        layout="@layout/actionbar_activity"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />


    <RelativeLayout
        android:id="@+id/relative"
        android:layout_below="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@string/postsubs"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_medium"
            android:visibility="visible"
            app:fonts="font_regular.ttf"
            />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/promotead"
        android:layout_width="match_parent"
        android:layout_above="@+id/bottbar"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relative"
        android:layout_marginTop="30dp"
        android:orientation="vertical">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
        <com.ni.external.ExpandableHeightListView
            android:id="@+id/promoteList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />
</ScrollView>

        <ImageView
            android:id="@+id/img1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-12dp"
            android:src="@drawable/promote_arrow"
            android:visibility="visible"
            app:tint="@color/bg" />

    </RelativeLayout>



    <RelativeLayout
        android:id="@+id/bottbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:gravity="center_horizontal">

        <com.ni.external.CustomTextView
            android:id="@+id/promote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:background="@color/primary"
            android:gravity="center"
            android:padding="15dp"
            android:singleLine="true"
            android:text="@string/subcription_now"
            android:textColor="@color/gph_white"
            android:textSize="18sp"
            android:visibility="visible"
            app:fonts="font_regular.ttf" />
    </RelativeLayout>






</RelativeLayout>