<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="ltr"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:orientation="vertical">

    <include
        android:id="@+id/actionbar"
        layout="@layout/actionbar_activity"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottbar"
        android:layout_below="@+id/actionbar">

        <RelativeLayout
            android:id="@+id/viewpage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/actionbar"
            android:background="@color/white"
            android:visibility="visible"
            android:layoutDirection="@string/layout_direction">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageView"
                android:layout_gravity="center_vertical"
                android:background="@color/white"
                android:orientation="vertical">

                <com.ni.external.CustomTextView
                    android:id="@+id/itemtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:text="Solid Wood, Engineered wood"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    app:fonts="font_regular.ttf"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imageView"
                    android:layout_gravity="center_vertical"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imageView"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone"
                        android:background="@color/white"
                        android:orientation="vertical">

                        <com.ni.external.CustomTextView
                            android:id="@+id/plan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/itemtitle"
                            android:paddingStart="10dp"
                            android:text="@string/plan"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_small"
                            app:fonts="font_regular.ttf" />


                        <com.ni.external.CustomTextView
                            android:id="@+id/plantxt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/valid"
                            android:layout_marginStart="5dp"
                            android:layout_toStartOf="@+id/lnext"
                            android:gravity="center_vertical"
                            android:padding="5dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textSize="@dimen/text_large"
                            android:textColor="@color/secondaryText"
                            app:fonts="font_regular.ttf" />
                    </LinearLayout>

                    <View
                        android:id="@+id/vie"
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/actionbar"
                        android:layout_marginStart="20dp"
                        android:background="@color/divider"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imageView"
                        android:layout_gravity="center_vertical"
                        android:background="@color/white"
                        android:orientation="vertical">

                        <com.ni.external.CustomTextView
                            android:id="@+id/currentSubscription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/itemtitle"
                            android:paddingStart="10dp"
                            android:text="@string/current_subscription"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_small"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/currentSubscriptionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/valid"
                            android:layout_marginStart="5dp"
                            android:layout_toStartOf="@+id/lnext"
                            android:gravity="center_vertical"
                            android:padding="5dp"
                            android:textSize="@dimen/text_large"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@color/primaryText"
                            app:fonts="font_regular.ttf" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imageView"
                    android:layout_gravity="center_vertical"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingTop="10dp">

                    <com.ni.external.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:text="@string/available_post"
                        android:textAppearance="@android:style/TextAppearance.Small"
                        android:textColor="@color/secondaryText"
                        android:textSize="@dimen/text_small"
                        app:fonts="font_regular.ttf" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/availablePostText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:padding="5dp"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:textSize="@dimen/text_large"
                        android:textColor="@color/primaryText"
                        app:fonts="font_regular.ttf" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingBottom="10dp"
                    android:paddingTop="10dp">

                    <com.ni.external.CustomTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:text="@string/Status"
                        android:textAppearance="@android:style/TextAppearance.Small"
                        android:textColor="@color/secondaryText"
                        android:textSize="@dimen/text_small"
                        app:fonts="font_regular.ttf" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/statustxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:padding="5dp"
                        android:text="Active"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:textSize="@dimen/text_medium"
                        android:textColor="@color/primaryText"
                        app:fonts="font_regular.ttf" />
                </LinearLayout>
            </LinearLayout>




        </RelativeLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/nullLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/no_item" />

        <com.ni.external.CustomTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:text="@string/sorry"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:text="@string/nosubscription"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/bottbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:gravity="center_horizontal">

        <com.ni.external.CustomTextView
            android:id="@+id/promote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:padding="15dp"
            android:singleLine="true"
            android:text="@string/repromote_your_list"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="gone"
            app:fonts="font_regular.ttf" />
    </RelativeLayout>

    <com.ni.external.CustomTextView
        android:id="@+id/subscripeView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:padding="15dp"
        android:singleLine="true"
        android:visibility="gone"
        android:text="@string/subcription_now"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:fonts="font_regular.ttf" />

</RelativeLayout>