<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/actionbar"
        layout="@layout/actionbar_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottombar"
        android:layout_below="@+id/actionbar">

        <LinearLayout
            android:id="@+id/mainLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:layoutDirection="@string/layout_direction"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/itemImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:adjustViewBounds="true"
                android:background="@color/bg"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageView"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:padding="15dp">

                <com.ni.external.CustomTextView
                    android:id="@+id/itemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="Solid Wood, Engineered wood"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/itemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:text="$ 0"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textDirection="ltr"
                    app:fonts="font_regular.ttf" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:padding="15dp">

                <com.ni.external.CustomTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sellername"
                    android:textAppearance="@android:style/TextAppearance.Small"
                    android:textColor="@color/secondaryText"
                    android:textSize="12sp"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/sellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Demo"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_large"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_toStartOf="@+id/change"
                    android:orientation="vertical">

                    <com.ni.external.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/address"
                        android:textAllCaps="true"
                        android:textAppearance="@android:style/TextAppearance.Small"
                        android:textColor="@color/secondaryText"
                        android:textSize="@dimen/text_small"
                        app:fonts="font_regular.ttf" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <com.ni.external.CustomTextView
                            android:id="@+id/nickName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/nickname"
                            android:textAlignment="viewStart"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_large"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/fullName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/Name"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_medium"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/addressLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/address1"
                            android:textAlignment="viewStart"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_medium"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/city"
                            android:textAlignment="viewStart"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_medium"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/country"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country"
                            android:textAlignment="viewStart"
                            android:textAppearance="@android:style/TextAppearance.Small"
                            android:textColor="@color/secondaryText"
                            android:textSize="@dimen/text_medium"
                            app:fonts="font_regular.ttf" />

                    </LinearLayout>
                </LinearLayout>

                <com.ni.external.CustomTextView
                    android:id="@+id/change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/secondary_curve_corner"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/change"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_medium"
                    android:visibility="visible"
                    app:fonts="font_bold.ttf" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:background="@color/bg" />

            <LinearLayout
                android:id="@+id/promoCodeLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.ni.external.CustomTextView
                    android:id="@+id/promoCodeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/promo_code"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    app:fonts="font_bold.ttf" />

                <LinearLayout
                    android:id="@+id/promoCodeInputLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/promo_code_input_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <EditText
                        android:id="@+id/promoCodeInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/enter_promo_code"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="@color/primaryText"
                        android:textColorHint="@color/secondaryText"
                        android:textSize="16sp" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/promoApplyBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/promo_copy_btn_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="22dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp"
                        android:text="@string/apply"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold"
                        app:fonts="font_bold.ttf" />
                </LinearLayout>

                <com.ni.external.CustomTextView
                    android:id="@+id/promoMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FF5252"
                    android:textSize="@dimen/text_small"
                    android:visibility="gone"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:background="@color/bg" />

            <com.ni.external.CustomTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:text="@string/price_details"
                android:textAppearance="@android:style/TextAppearance.Small"
                android:textColor="@color/secondaryText"
                android:textSize="@dimen/text_normal"
                app:fonts="font_regular.ttf" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="locale"
                android:orientation="horizontal"
                android:padding="15dp">

                <com.ni.external.CustomTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="start|center_vertical"
                    android:text="@string/price"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/price"
                    android:layout_width="226dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:gravity="center_vertical|end"
                    android:text="$0"
                    android:textDirection="ltr"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:visibility="gone"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="locale"
                android:visibility="gone"
                android:orientation="horizontal"
                android:padding="15dp">

                <com.ni.external.CustomTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="start|center_vertical"
                    android:text="@string/shipping_fee"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/shipping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:gravity="center_vertical|end"
                    android:text="$0"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textDirection="ltr"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/discountLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="locale"
                android:orientation="horizontal"
                android:padding="15dp"
                android:visibility="gone">

                <com.ni.external.CustomTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="start|center_vertical"
                    android:text="@string/discount"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/discountAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:gravity="center_vertical|end"
                    android:text="-$0"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primary"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <View
                android:id="@+id/discountDivider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="locale"
                android:orientation="horizontal"
                android:padding="15dp">

                <com.ni.external.CustomTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="start|center_vertical"
                    android:text="@string/order_total"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:gravity="center_vertical|end"
                    android:text="$0"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:textColor="@color/primaryText"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/progress"
        android:layout_width="@dimen/progress_size"
        android:layout_height="@dimen/progress_size"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:indicatorColor="@color/progressColor"
        app:indicatorName="BallPulseIndicator" />

    <RelativeLayout
        android:id="@+id/bottombar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal">

        <com.ni.external.CustomTextView
            android:id="@+id/paynow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:background="@color/primary"
            android:gravity="center"
            android:padding="15dp"
            android:singleLine="true"
            android:text="@string/pay"
            android:textColor="@color/white"
            android:textSize="@dimen/text_large"
            android:visibility="visible"
            app:fonts="font_regular.ttf" />
    </RelativeLayout>

</RelativeLayout>