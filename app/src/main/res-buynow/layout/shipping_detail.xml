<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/actionbar"
        layout="@layout/actionbar_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line"
        app:layout_constraintTop_toBottomOf="@+id/actionbar" />
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:layout_constraintTop_toBottomOf="@id/view"
    app:layout_constraintBottom_toTopOf="@+id/bottbar">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layoutDirection="@string/layout_direction"
        android:orientation="vertical"
        android:paddingTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/view">
        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemtitle"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:text="@string/shipping_date"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/primaryText"
            android:textSize="12sp"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/shippingdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:padding="10dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/actionbar"
            android:background="@color/line" />

        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemtitle"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:text="@string/courier_name"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/primaryText"
            android:textSize="12sp"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomEditText
            android:id="@+id/couriername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:maxLength="60"
            android:padding="10dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />

        <View
            android:id="@+id/vie"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/actionbar"
            android:background="@color/line" />

        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemtitle"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:text="@string/courier_service"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/primaryText"
            android:textSize="12sp"
            android:visibility="visible"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomEditText
            android:id="@+id/shippingservice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:maxLength="60"
            android:padding="10dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            android:visibility="visible"
            app:fonts="font_regular.ttf" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/actionbar"
            android:background="@color/line" />

        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemtitle"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:text="@string/tracking_id"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/primaryText"
            android:textSize="12sp"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomEditText
            android:id="@+id/trackingid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:maxLength="60"
            android:padding="10dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/actionbar"
            android:background="@color/line" />

        <com.ni.external.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemtitle"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:text="@string/other_details"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/primaryText"
            android:textSize="12sp"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomEditText
            android:id="@+id/otherdetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:overScrollMode="always"
            android:padding="10dp"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical"
            android:text=""
            android:inputType="textMultiLine"
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primaryText"
            app:fonts="font_regular.ttf" />
    </LinearLayout>
</ScrollView>
    <RelativeLayout
        android:id="@+id/bottbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.ni.external.CustomTextView
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@color/primary"
            android:gravity="center"
            android:padding="15dp"
            android:singleLine="true"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="visible"
            app:fonts="font_regular.ttf" />
    </RelativeLayout>

    <com.ni.external.timessquare.CalendarPickerView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/view"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/view" />

</androidx.constraintlayout.widget.ConstraintLayout>