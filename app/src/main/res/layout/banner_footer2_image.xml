<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@android:color/white"
    android:layoutDirection="@string/layout_direction"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layoutDirection="@string/layout_direction">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/linear"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:layoutDirection="@string/layout_direction">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textStyle="bold"
                android:textSize="@dimen/text_small"
                android:id="@+id/txt_title"
                android:singleLine="false"
                android:textAlignment="viewStart"
                android:layoutDirection="@string/layout_direction"
                android:textColor="@color/dateTimeRangePickerTitleTextColor" />

          <!--  <View
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shop now to save big gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg"
                android:textStyle="normal"
                android:textSize="@dimen/text_next_normal"
                android:id="@+id/txt_content"
                android:singleLine="false"
                android:textAlignment="viewStart"
                android:textColor="@color/black_text"
                android:visibility="gone"/>-->
        </LinearLayout>

        <ImageView
            android:id="@+id/image_banner1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:layout_weight="1.4"/>

    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress"
        style="?android:progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:padding="20dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

</androidx.cardview.widget.CardView>