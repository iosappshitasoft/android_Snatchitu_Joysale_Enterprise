<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!--Date Layout-->

    <RelativeLayout
        android:id="@+id/dateLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:background="@android:color/transparent">

        <com.ni.external.CustomTextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@android:color/transparent"
            android:padding="10dp"

            android:text="Jan 1st 2015"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_normal"
            app:fonts="font_regular.ttf" />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/missedcalllay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="ltr"
        android:visibility="gone">

        <ImageView
            android:id="@+id/missedcallimage"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:src="@drawable/missed_call"
            android:visibility="gone" />


        <com.ni.external.CustomTextView
            android:id="@+id/missedcall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/missedcallimage"
            android:gravity="center"
            android:padding="5dp" />

        <com.ni.external.CustomTextView
            android:id="@+id/missedcalltime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/missedcall"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:padding="5dp" />


    </RelativeLayout>

    <!--Left Side Layout-->
    <RelativeLayout
        android:id="@+id/leftLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layoutDirection="ltr">

        <!--Left Message Layout-->

        <RelativeLayout
            android:id="@+id/left_msg_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="80dp"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:id="@+id/leftCorner"
                android:layout_width="25dp"
                android:layout_height="20dp"
                android:src="@drawable/chat_bg_left" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/leftCorner"
                android:layout_marginStart="5dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/chat_left_corner"
                android:minWidth="80dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/leftDelete"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:padding="5dp"
                    android:src="@drawable/delete_left"
                    android:visibility="gone" />

                <com.ni.external.CustomTextView
                    android:id="@+id/leftMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/leftDelete"
                    android:gravity="center_vertical"
                    android:minWidth="100dp"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="ftyftyfty"
                    android:textColor="@color/primaryText4"
                    android:textSize="@dimen/text_medium"
                    android:visibility="visible"
                    app:fonts="font_regular.ttf" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/leftMsg"
                    android:layout_alignRight="@+id/leftMsg"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="7dp">

                    <com.ni.external.CustomTextView
                        android:id="@+id/leftTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="6dp"
                        android:gravity="end"
                        android:text="11:11"
                        android:textAlignment="textEnd"
                        android:textColor="@color/secondaryText"
                        android:textSize="@dimen/text_small"
                        app:fonts="font_regular.ttf" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/translatebtn"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignRight="@+id/leftMsg"
                        android:background="@drawable/chat_translate"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorPrimary"
                        android:visibility="gone" />

                </LinearLayout>
            </RelativeLayout>

        </RelativeLayout>

        <ImageView
            android:id="@+id/left_gifView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="start"
            android:layout_marginStart="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone" />

        <!--Left Audio -->
        <RelativeLayout
            android:id="@+id/left_audio_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="80dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="20dp"
                android:src="@drawable/chat_bg_left"
                app:tint="#e1e8eb" />

            <RelativeLayout
                android:id="@+id/audioReceiveLay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/chat_left_bg"
                android:layoutDirection="@string/layout_direction"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/receiveSeekbar"
                    style="@style/ReceiverSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_toEndOf="@+id/downloadLay"
                    android:paddingStart="10dp"
                    android:paddingEnd="15dp" />

                <FrameLayout
                    android:id="@+id/downloadLay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:backgroundTint="#80000000">

                    <ImageView
                        android:id="@+id/left_download_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="13dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_audio_download" />


                    <com.ni.external.ProgressWheel
                        android:id="@+id/downloadProgress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="7dp"
                        android:visibility="gone"
                        app:matProg_barColor="@color/colorPrimary"
                        app:matProg_barWidth="2dp"
                        app:matProg_progressIndeterminate="true" />

                    <ImageView
                        android:id="@+id/btnReceivePlay"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_play_white"
                        android:visibility="gone"
                        app:tint="@color/secondaryText" />

                </FrameLayout>

                <com.ni.external.CustomTextView
                    android:id="@+id/txtReceiveDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/receiveSeekbar"
                    android:layout_alignEnd="@+id/receiveSeekbar"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="start"
                    android:paddingBottom="5dp"
                    android:singleLine="true"
                    android:text="0:00"
                    android:textColor="@color/secondaryText"
                    android:textSize="@dimen/text_small"
                    app:fonts="font_regular.ttf" />

            </RelativeLayout>
        </RelativeLayout>
        <!--Left Image and Map Layout-->

        <RelativeLayout
            android:id="@+id/left_image_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_bg_left" />

            <RelativeLayout
                android:layout_width="290dp"
                android:layout_height="190dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="5dp"
                android:background="@drawable/chat_left_corner"
                android:minWidth="65dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/left_image"
                    android:layout_width="280dp"
                    android:layout_height="180dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="5dp"
                    android:scaleType="centerCrop" />

                <com.ni.external.CustomTextView
                    android:id="@+id/leftImgTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="7dp"
                    android:gravity="center_vertical"
                    android:shadowColor="@color/primaryText"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="4"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small"
                    app:fonts="font_regular.ttf" />
            </RelativeLayout>

        </RelativeLayout>


        <!--Left Offer Layout-->

        <RelativeLayout
            android:id="@+id/left_makeoffer_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_make_offer_bg_left"
                app:tint="@color/green_color" />

            <LinearLayout
                android:id="@+id/make"
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="5dp"
                android:background="@drawable/makeoffer_roundcorner"
                android:minWidth="65dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="@string/layout_direction"
                    android:minHeight="120dp"
                    android:orientation="horizontal">

                    <com.ni.external.CustomTextView
                        android:id="@+id/left_makeoffer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="5dp"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_regular.ttf" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/left_makeoffer_name"
                        android:orientation="horizontal">

                        <com.ni.external.RoundedImageView
                            android:id="@+id/leftOfferImg"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="15dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="4dip" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/left_makeoffer_name"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"
                            android:layout_toEndOf="@+id/leftOfferImg"
                            android:orientation="vertical">

                            <com.ni.external.CustomTextView
                                android:id="@+id/left_makeoffer_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/acceptoffer_roundcorner"
                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/green_color"
                                android:textSize="@dimen/text_medium"
                                app:fonts="font_regular.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/left_makeoffer_msg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_normal"
                                app:fonts="font_regular.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/left_makeoffer_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_normal"
                                app:fonts="font_regular.ttf" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/makeoffer_btn_roundcorner"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/offerstatusLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="20">

                        <com.ni.external.CustomTextView
                            android:id="@+id/offerAccept"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="9.95"
                            android:gravity="center"
                            android:padding="15dp"
                            android:text="@string/accept"
                            android:textColor="@color/green_color"
                            android:textSize="@dimen/text_normal"
                            app:fonts="font_regular.ttf" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"
                            android:background="@color/divider" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/offerDeclined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="9.95"
                            android:gravity="center"
                            android:padding="15dp"
                            android:text="@string/decline"
                            android:textSize="@dimen/text_normal"
                            app:fonts="font_regular.ttf" />


                    </LinearLayout>

                    <com.ni.external.CustomTextView
                        android:id="@+id/translatebtnOfferLeft"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="end"
                        android:layout_marginBottom="5dp"
                        android:background="@drawable/chat_translate"
                        android:backgroundTint="@color/colorPrimary"
                        android:gravity="center"
                        android:padding="5dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/colorPrimary"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>


        </RelativeLayout>


    </RelativeLayout>

    <!--Right Side Layout-->

    <RelativeLayout
        android:id="@+id/rightLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layoutDirection="ltr">
        <!--Right Message Layout-->

        <RelativeLayout
            android:id="@+id/right_msg_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_bg_right"
                app:tint="@color/chat_right_color" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/chat_right_corner"
                android:minWidth="100dp"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/rightDelete"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:padding="5dp"
                    android:src="@drawable/delete_right"
                    android:visibility="gone" />

                <com.ni.external.CustomTextView
                    android:id="@+id/rightMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/rightDelete"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text=""
                    android:textColor="@color/primaryText4"
                    android:textSize="@dimen/text_medium"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/rightTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rightMsg"
                    android:layout_alignEnd="@+id/rightMsg"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    android:text=""
                    android:textColor="@color/primaryText4"
                    android:textSize="@dimen/text_small"
                    app:fonts="font_regular.ttf" />
            </RelativeLayout>

        </RelativeLayout>

        <ImageView
            android:id="@+id/right_gifView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone" />

        <!--Right Audio -->
        <RelativeLayout
            android:id="@+id/right_audio_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/rightCorner"
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layoutDirection="ltr"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_bg_right"
                app:tint="@color/chat_right_color" />

            <RelativeLayout
                android:id="@+id/audioSentLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"

                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/chat_right_bg"
                android:layoutDirection="@string/layout_direction"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnSentPlay"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_play_white"
                    app:tint="@color/white" />

                <SeekBar
                    android:id="@+id/sentSeekbar"
                    style="@style/SenderSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_toEndOf="@+id/btnSentPlay"
                    android:paddingStart="10dp"
                    android:paddingEnd="15dp" />

                <com.ni.external.CustomTextView
                    android:id="@+id/txtSentDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/sentSeekbar"
                    android:layout_alignEnd="@+id/sentSeekbar"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="0:00"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small"
                    app:fonts="font_regular.ttf" />
            </RelativeLayout>

        </RelativeLayout>

        <!--Right Image and Map  Layout-->
        <RelativeLayout
            android:id="@+id/right_image_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_bg_right"
                app:tint="@color/chat_right_color" />

            <RelativeLayout
                android:layout_width="290dp"
                android:layout_height="190dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/chat_right_corner"
                android:minWidth="65dp"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/right_image"
                    android:layout_width="280dp"
                    android:layout_height="180dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="5dp"
                    android:scaleType="centerCrop" />

                <com.ni.external.CustomTextView
                    android:id="@+id/rightImgTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:shadowColor="@color/primaryText"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="4"
                    android:text=""
                    android:textColor="@color/divider"
                    android:textSize="@dimen/text_small"
                    app:fonts="font_regular.ttf" />
            </RelativeLayout>

        </RelativeLayout>

        <!--Right Offer Layout-->
        <RelativeLayout
            android:id="@+id/right_makeoffer_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:scaleType="centerCrop"
                android:src="@drawable/chat_make_offer_bg_right"
                app:tint="@color/green_color" />

            <LinearLayout
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/makeoffer_roundcorner"
                android:minWidth="65dp"
                android:orientation="vertical"
                android:padding="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="@string/layout_direction"
                    android:orientation="horizontal">

                    <com.ni.external.CustomTextView
                        android:id="@+id/right_makeoffer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="5dp"
                        android:maxLines="2"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_regular.ttf" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/right_makeoffer_name"
                        android:orientation="horizontal">

                        <com.ni.external.RoundedImageView
                            android:id="@+id/rightOfferImg"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="15dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="4dip" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical">


                            <com.ni.external.CustomTextView
                                android:id="@+id/right_makeoffer_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/acceptoffer_roundcorner"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/green_color"
                                android:textSize="@dimen/text_medium"
                                app:fonts="font_regular.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/right_makeoffer_msg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_normal"
                                app:fonts="font_regular.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/right_makeoffer_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingRight="5dp"
                                android:paddingBottom="5dp"
                                android:text=""
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_normal"
                                app:fonts="font_regular.ttf" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!--Offer Accept Status Layout-->
    <RelativeLayout
        android:id="@+id/offer_result_lay"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/acceptoffer_roundcorner"
        android:layoutDirection="@string/layout_direction"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.ni.external.RoundedImageView
                android:id="@+id/offerResultImg"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:scaleType="centerCrop"
                app:riv_corner_radius="4dip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/offerResultIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/offer_accept_icon" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/offerResultMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:paddingStart="25dp"
                        android:text="@string/offer_accept_msg"
                        android:textColor="@color/green_color"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_regular.ttf" />

                </RelativeLayout>

                <com.ni.external.CustomTextView
                    android:id="@+id/offerResultPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:paddingTop="5dp"
                    android:text=""
                    android:textAlignment="viewStart"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_large"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/offerResultTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:text=""
                    android:textColor="@color/secondaryText"
                    android:textSize="@dimen/text_normal"
                    app:fonts="font_regular.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/buyOfferPrd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/makeoffer_roundcorner"
                    android:paddingStart="20dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="5dp"
                    android:text="@string/instantbuy"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_medium"
                    android:visibility="visible"
                    app:fonts="font_regular.ttf" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!--Item Layout-->

    <RelativeLayout
        android:id="@+id/itemLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/acceptoffer_roundcorner"
        android:layoutDirection="@string/layout_direction"
        android:visibility="gone">

        <com.ni.external.RoundedImageView
            android:id="@+id/itemImage"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_margin="10dp"
            android:adjustViewBounds="true"
            android:background="@color/grey"
            android:scaleType="centerCrop"
            app:riv_corner_radius="3dp"
            app:riv_mutate_background="true" />

        <com.ni.external.CustomTextView
            android:id="@+id/itemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/itemImage"
            android:text="About Item"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_large"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/aboutDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/itemName"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/itemImage"
            android:text=""
            android:textColor="@color/secondaryText"
            android:textSize="@dimen/text_normal"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/aboutDate"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:layout_toEndOf="@+id/itemImage"
            android:background="@drawable/primary_curve_corner"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/text_normal"
            android:visibility="gone"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/aboutMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/price"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:layout_toEndOf="@+id/itemImage"
            android:gravity="center_vertical"
            android:text="text"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_normal"
            android:visibility="gone"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/translatebtnAbout"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@+id/aboutMsg"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/chat_translate"
            android:backgroundTint="@color/colorPrimary"
            android:gravity="center_horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/colorPrimary"
            android:visibility="invisible" />

    </RelativeLayout>

</LinearLayout>