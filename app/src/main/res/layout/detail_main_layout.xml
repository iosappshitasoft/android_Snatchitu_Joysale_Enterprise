<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layoutDirection="locale"
    android:background="@color/bg">

    <RelativeLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/colorPrimary"
        android:layoutDirection="ltr">

        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="10dp"
            android:tint="@color/primary"
            android:src="@drawable/back"
            android:visibility="visible" />

        <com.ni.external.CustomTextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/optionsLay"
            android:layout_toEndOf="@+id/backbtn"
            android:ellipsize="end"
            android:gravity="start"
            android:layoutDirection="ltr"
            android:maxLines="1"
            android:text="12 h"
            android:textAlignment="viewStart"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/primary"
            app:fonts="font_regular.ttf" />

        <LinearLayout
            android:id="@+id/optionsLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/likereditBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/shareBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:padding="10dp"
                android:tint="@color/primary"
                android:src="@drawable/unlike_icon"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/edit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/shareBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:padding="10dp"
                android:tint="@color/primary"
                android:src="@drawable/edit"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/shareBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/settingBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:tint="@color/primary"
                android:src="@drawable/share_icon"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/settingBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:paddingTop="10dp"
                android:tint="@color/primary"
                android:paddingBottom="10dp"
                android:src="@drawable/option_icon"
                android:visibility="visible" />
        </LinearLayout>
    </RelativeLayout>

    <com.ni.external.parallaxscroll.ParallaxScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/saveLay"
        android:layout_below="@+id/actionbar"
        android:layoutDirection="@string/layout_direction"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="blocksDescendants"
            android:layoutDirection="@string/layout_direction">

            <FrameLayout
                android:id="@+id/imageLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusableInTouchMode="true"
                android:visibility="visible">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="visible" />

                <com.ni.external.CustomTextView
                    android:id="@+id/discountRibbon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|top"
                    android:layout_marginLeft="-36dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/discount_ribbon_bg"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:paddingLeft="40dp"
                    android:paddingTop="5dp"
                    android:paddingRight="40dp"
                    android:paddingBottom="5dp"
                    android:rotation="-45"
                    android:text="-50% OFF"
                    android:textColor="@color/white"
                    android:textDirection="ltr"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:fonts="font_bold.ttf" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/blacktrans">

                    <LinearLayout
                        android:id="@+id/youtubeLay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/play" />

                        <com.ni.external.CustomTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="5dp"
                            android:gravity="center"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/play_video"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_small"
                            app:fonts="font_regular.ttf" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/imageCountLay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/rounded_transparent_bg"
                        android:gravity="start"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center_vertical"
                            android:padding="2dp"
                            android:src="@drawable/photos" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/txtImageCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="5dp"
                            android:textAppearance="?android:textAppearanceMedium"
                            android:textColor="@color/gph_white"
                            android:textSize="@dimen/text_small"
                            app:fonts="font_regular.ttf" />

                    </LinearLayout>

                </RelativeLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/detailLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageLay"
                android:background="@color/bg"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="@string/layout_direction"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/itemLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/statusLay"
                        android:layoutDirection="@string/layout_direction"
                        android:orientation="vertical">

                        <com.ni.external.CustomTextView
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:gravity="start"
                            android:maxLength="70"
                            android:maxLines="3"
                            android:text="Product Title"
                            android:textAlignment="viewStart"
                            android:textAppearance="?android:textAppearanceMedium"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_very_large"
                            android:visibility="visible"
                            app:fonts="font_regular.ttf" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:layoutDirection="@string/layout_direction"
                            android:orientation="horizontal">

                            <com.ni.external.CustomTextView
                                android:id="@+id/itemPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:singleLine="true"
                                android:text="$ 0"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textColor="@color/primaryText"
                                android:textDirection="ltr"
                                android:textSize="@dimen/text_large"
                                app:fonts="font_bold.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/originalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="start"
                                android:singleLine="true"
                                android:text="$ 0"
                                android:textColor="#888888"
                                android:textDirection="ltr"
                                android:textSize="@dimen/text_medium"
                                android:visibility="gone"
                                app:fonts="font_regular.ttf" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/discountedLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="start"
                                android:singleLine="true"
                                android:text="@string/discounted"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_medium"
                                android:visibility="gone"
                                app:fonts="font_bold.ttf" />
                        </LinearLayout>

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/statusLay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:layoutDirection="@string/layout_direction"
                        android:orientation="vertical">

                        <com.ni.external.CustomTextView
                            android:id="@+id/itemStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="-5dp"
                            android:background="@drawable/urgentbg"
                            android:gravity="bottom"
                            android:paddingStart="7dp"
                            android:paddingTop="18dp"
                            android:paddingEnd="7dp"
                            android:paddingBottom="7dp"
                            android:singleLine="true"
                            android:text="Urgent"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="visible"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/postedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="15dp"
                            android:gravity="end"
                            android:singleLine="true"
                            android:text="12 hours ago"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_small"
                            app:fonts="font_regular.ttf" />

                    </LinearLayout>


                    <com.ni.external.CustomTextView
                        android:id="@+id/itemCond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/itemLay"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/secondary_curve_corner"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:singleLine="true"
                        android:text="Used"
                        android:textColor="@color/gph_white"
                        android:textSize="@dimen/text_normal"
                        android:visibility="visible"
                        app:fonts="font_regular.ttf" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/itemCond"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="15dp"
                        android:orientation="horizontal"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp">

                        <com.ni.external.CircularImageView
                            android:id="@+id/btnFacebook"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="5dp"
                            android:padding="3dp"
                            android:src="@drawable/facebook" />

                        <com.ni.external.CircularImageView
                            android:id="@+id/btnTwitter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="5dp"
                            android:background="@color/white"
                            android:padding="3dp"
                            android:src="@drawable/twitter" />

                        <ImageView
                            android:id="@+id/btnWhatsapp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="5dp"
                            android:padding="3dp"
                            android:src="@drawable/whatsapp" />

                        <com.ni.external.CircularImageView
                            android:id="@+id/btnMore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="3dp"
                            android:src="@drawable/more" />

                    </LinearLayout>

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:background="@color/bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="@color/white"
                    android:layoutDirection="@string/layout_direction"
                    android:orientation="vertical">

                    <com.ni.external.CustomTextView
                        android:id="@+id/txtDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="15dp"
                        android:text="@string/details"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryText"
                        android:textColorLink="@color/blue"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_bold.ttf" />


                    <LinearLayout
                        android:id="@+id/filterLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="10dp"
                        android:gravity="start"
                        android:layoutDirection="@string/layout_direction"
                        android:orientation="vertical" />

                    <View
                        android:id="@+id/detailsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@color/bg" />

                    <com.ni.external.CustomTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="15dp"
                        android:text="@string/description"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryText"
                        android:textColorLink="@color/blue"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_bold.ttf" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:autoLink="web"
                        android:gravity="start"
                        android:linksClickable="true"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/description"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryText"
                        android:textColorLink="@color/blue"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_medium"
                        app:fonts="font_regular.ttf" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/bg" />

                </LinearLayout>

                <include
                    android:id="@+id/descriptionAdView"
                    layout="@layout/layout_adview" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:background="@color/bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layoutDirection="@string/layout_direction"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="5dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/primaryText"
                            android:src="@drawable/view_icon" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/viewCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:singleLine="true"
                            android:text="50 Views"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_normal"
                            app:fonts="font_regular.ttf" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/likesImg"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/primaryText"
                            android:src="@drawable/likecount" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/likesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:singleLine="true"
                            android:text="55 Likes"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_normal"
                            app:fonts="font_regular.ttf" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/commentLay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/primaryText"
                            android:src="@drawable/commentcount" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/commentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:singleLine="true"
                            android:text="15"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_normal"
                            app:fonts="font_regular.ttf" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/promoCodeLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:layoutDirection="@string/layout_direction"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <com.ni.external.CustomTextView
                        android:id="@+id/promoCodeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:text="@string/promo_code"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryText"
                        android:textSize="@dimen/text_medium"
                        android:textStyle="bold"
                        app:fonts="font_bold.ttf" />

                    <LinearLayout
                        android:id="@+id/promoCodeInputLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/promo_code_input_bg"
                        android:gravity="center_vertical"
                        android:layoutDirection="@string/layout_direction"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <com.ni.external.CustomTextView
                            android:id="@+id/promoCodeText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:singleLine="true"
                            android:text=""
                            android:textAlignment="viewStart"
                            android:textColor="@color/primaryText"
                            android:textSize="18sp"
                            app:fonts="font_regular.ttf" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/promoCopyBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/promo_copy_btn_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="22dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="22dp"
                            android:paddingBottom="10dp"
                            android:text="@string/copy"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_normal"
                            android:textStyle="bold"
                            app:fonts="font_bold.ttf" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:background="@color/bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RelativeLayout
                        android:id="@+id/Lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white">

                        <ImageView
                            android:id="@+id/locationImg"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="8dp"
                            android:tint="@color/primaryText"
                            android:src="@drawable/location_icon" />

                        <com.ni.external.CustomTextView
                            android:id="@+id/location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:layout_toEndOf="@+id/locationImg"
                            android:gravity="start"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:singleLine="true"
                            android:text="Madurai, Tamil Nadu, India"
                            android:textAlignment="viewStart"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_normal"
                            android:visibility="visible"
                            app:fonts="font_regular.ttf" />
                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/banner"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_below="@+id/Lay"
                        android:layout_marginTop="10dp"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:visibility="visible" />

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/banner"
                        android:background="@color/white" />

                    <com.ni.external.RoundedImageView
                        android:id="@+id/userImage"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_below="@+id/banner"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="16dp"
                        android:adjustViewBounds="true"
                        android:background="@color/white"
                        android:gravity="center_horizontal"
                        android:scaleType="centerCrop"
                        app:riv_corner_radius="100dip"
                        app:riv_mutate_background="true" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/banner"
                        android:layout_toEndOf="@+id/userImage">

                        <com.ni.external.CustomTextView
                            android:id="@+id/userName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="start"
                            android:singleLine="true"
                            android:text="demo"
                            android:textAlignment="viewStart"
                            android:textColor="@color/primaryText"
                            android:textSize="@dimen/text_large"
                            app:fonts="font_regular.ttf" />

                        <RelativeLayout
                            android:id="@+id/reviewLay"
                            android:layout_width="235dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/userName"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="-115dp"
                            android:layout_marginBottom="35dp"
                            android:layoutDirection="ltr"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <RatingBar
                                android:id="@+id/ratingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_centerHorizontal="true"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:rating="3.5"
                                android:scaleX=".4"
                                android:scaleY=".4"
                                android:stepSize="1"
                                android:theme="@style/RatingBar"
                                android:transformPivotX="-1dp"
                                android:transformPivotY="0dp" />

                            <com.ni.external.CustomTextView
                                android:id="@+id/ratingCount"
                                android:layout_width="33dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="95dp"
                                android:layout_marginTop="2dp"
                                android:text="(4.0)"
                                android:textAppearance="@android:style/TextAppearance.Small"
                                android:textColor="@color/primaryText"
                                app:fonts="font_regular.ttf" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="40dp"
                            android:orientation="horizontal"
                            android:paddingBottom="15dp"
                            android:weightSum="3">

                            <ImageView
                                android:id="@+id/mblverify"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/mob_unveri"
                                android:visibility="visible" />

                            <ImageView
                                android:id="@+id/fbverify"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:src="@drawable/fb_unveri"
                                android:visibility="visible" />

                            <ImageView
                                android:id="@+id/mailverify"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/mail_unveri"
                                android:visibility="visible" />
                        </LinearLayout>

                        <com.ni.external.CustomTextView
                            android:id="@+id/call"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/primary_curve_corner"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="@string/call"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_normal"
                            android:visibility="visible"
                            app:fonts="font_regular.ttf" />
                    </RelativeLayout>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/moreitemsLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <com.ni.external.CustomTextView
                        android:id="@+id/moretext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="more items"
                        android:textAlignment="viewStart"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:textColor="@color/primaryText"
                        app:fonts="font_regular.ttf" />

                    <com.wang.avi.AVLoadingIndicatorView
                        android:id="@+id/progress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/progressColor"
                        app:indicatorName="BallPulseIndicator" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/userRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <com.ni.external.CustomTextView
                        android:id="@+id/txtRelatedProducts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="0dp"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text="@string/related_products"
                        android:textAlignment="viewStart"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:textColor="@color/primaryText"
                        android:visibility="visible"
                        app:fonts="font_regular.ttf" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/relatedRecycleView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

                <include
                    android:id="@+id/bottomAdView"
                    layout="@layout/layout_adview" />

            </LinearLayout>

        </RelativeLayout>

    </com.ni.external.parallaxscroll.ParallaxScrollView>

    <LinearLayout
        android:id="@+id/saveLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="horizontal">

        <com.ni.external.CustomTextView
            android:id="@+id/chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorSecondary"
            android:gravity="center"
            android:padding="16dp"
            android:singleLine="true"
            android:text="@string/chat"
            android:textColor="@color/gph_white"
            android:textSize="@dimen/text_large"
            app:fonts="font_regular.ttf" />

        <com.ni.external.CustomTextView
            android:id="@+id/offer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/primary"
            android:gravity="center"
            android:padding="17dp"
            android:singleLine="true"
            android:text="@string/make_an_offer"
            android:textColor="@color/white"
            android:textSize="@dimen/text_large"
            app:fonts="font_regular.ttf" />
    </LinearLayout>

</RelativeLayout>