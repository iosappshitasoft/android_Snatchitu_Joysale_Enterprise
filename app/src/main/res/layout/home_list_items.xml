<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layoutDirection="@string/layout_direction"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/home_items_curve_shape"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/imageLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/singleImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/home_item_image_clip"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true"
                android:layout_gravity="bottom"
                android:background="@drawable/blacktrans" />

            <com.ni.external.CustomTextView
                android:id="@+id/discountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="-28dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/discount_ribbon_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:paddingLeft="28dp"
                android:paddingTop="3dp"
                android:paddingRight="28dp"
                android:paddingBottom="3dp"
                android:rotation="-45"
                android:text="-50% OFF"
                android:textColor="@color/white"
                android:textDirection="ltr"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:fonts="font_bold.ttf" />

            <com.ni.external.CustomTextView
                android:id="@+id/postedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="10dp"
                android:text="0 hours ago"
                android:textColor="@color/gph_white"
                android:textSize="12sp"
                app:fonts="font_regular.ttf" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="-5dp">

                <com.ni.external.CustomTextView
                    android:id="@+id/productType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/urgentbg"
                    android:paddingBottom="5dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:paddingTop="13dp"
                    android:text="Urgent"
                    android:textColor="@color/gph_white"
                    android:textSize="11sp"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/detailLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.ni.external.CustomTextView
                android:id="@+id/affiliateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="@string/discounted"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:visibility="gone"
                app:fonts="font_regular.ttf" />

            <LinearLayout
                android:id="@+id/priceLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.ni.external.CustomTextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="$ 0"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/primaryText"
                    app:fonts="font_bold.ttf" />

                <com.ni.external.CustomTextView
                    android:id="@+id/originalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="$ 0"
                    android:textColor="#888888"
                    android:textDirection="ltr"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:fonts="font_regular.ttf" />
            </LinearLayout>

            <com.ni.external.CustomTextView
                android:id="@+id/itemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:text="itemName"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="@dimen/text_medium"
                android:textColor="@color/primaryText"
                app:fonts="font_regular.ttf" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dip"
                android:layout_marginTop="3dp"
                android:background="@color/divider" />

            <com.ni.external.CustomTextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:text="location"
                android:textColor="@color/secondaryText"
                android:textSize="12sp"
                app:fonts="font_regular.ttf" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>