<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLay"
    android:layout_width="150dp"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:layout_marginRight="2dp"
    android:layout_height="200dp"
    android:layoutDirection="@string/layout_direction"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="true">
            <RelativeLayout
                android:id="@+id/imageLay"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/home_items_curve_shape">

                <com.ni.external.RoundedImageView
                    android:id="@+id/singleImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="@null"
                    android:scaleType="centerCrop"
                    app:riv_corner_radius="3dp" />

             <!--   <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="bottom"
                    android:background="@drawable/blacktrans" />
-->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="bottom" />

                <com.ni.external.CustomTextView
                    android:id="@+id/postedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="0 hours ago"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:fonts="font_regular.ttf" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">

                    <com.ni.external.CustomTextView
                        android:id="@+id/productType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/urgentbg_new"
                        android:padding="7dp"
                        android:text="Urgent"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:fonts="font_regular.ttf" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>


        <LinearLayout
            android:id="@+id/detailLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.ni.external.CustomTextView
                android:id="@+id/priceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="$ 0"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/primaryText"
                app:fonts="font_bold.ttf" />

            <com.ni.external.CustomTextView
                android:id="@+id/itemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:text="itemName"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="@dimen/text_medium"
                android:textColor="@color/primaryText"
                app:fonts="font_regular.ttf" />

            <com.ni.external.CustomTextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:text="location"
                android:textColor="@color/secondaryText"
                android:textSize="12sp"
                app:fonts="font_regular.ttf" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>