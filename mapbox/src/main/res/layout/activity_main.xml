<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:mapbox="http://schemas.android.com/tools"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/color_primary">

        <ImageView
            android:id="@+id/back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/back"
            android:layout_marginStart="16dp"
            android:layout_gravity="center"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="15dp"
            android:singleLine="true"
            android:text="@string/set_location"
            android:textColor="@color/white"
            android:textSize="18sp"
            />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/actionbar">


        <com.mapbox.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            mapbox:mapbox_cameraTargetLat="40.73581"
            mapbox:mapbox_cameraTargetLng="-73.99155"
            mapbox:mapbox_cameraZoom="11"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/markerLay"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/marker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="20dp"
                android:background="@null"
                android:src="@drawable/map"
                android:visibility="visible" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/actionbar"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/white_roundcorner"
        android:elevation="4dp"
        android:padding="5dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/search"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:padding="5dp"
            android:src="@drawable/search_gray"
            android:visibility="visible" />

        <AutoCompleteTextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/cross_icon"
            android:layout_toEndOf="@+id/search"
            android:background="@color/white"
            android:dropDownAnchor="@+id/searchLayout"
            android:dropDownWidth="match_parent"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="6dp"
            android:popupBackground="@drawable/white_roundcorner"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Small" />

        <ImageView
            android:id="@+id/cross_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@color/white"
            android:padding="7dp"
            android:src="@drawable/cancel"
            android:visibility="gone"
            app:tint="@color/primaryText" />
    </RelativeLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/searchLayout"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:background="#00000000"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/my_location"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_above="@+id/bottomLay"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/my_location" />

    <RelativeLayout
        android:id="@+id/bottomLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/colorSecondary"
                android:gravity="center"
                android:padding="15dp"
                android:singleLine="true"
                android:text="@string/world_wide"
                android:textColor="@color/white"
                android:textSize="18sp"
                 />

            <TextView
                android:id="@+id/apply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:padding="15dp"
                android:singleLine="true"
                android:text="@string/set_location"
                android:textColor="@color/white"
                android:textSize="18sp"
                />

            <TextView
                android:id="@+id/test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:padding="15dp"
                android:singleLine="true"
                android:text="Test"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:visibility="gone"
                 />
        </LinearLayout>


    </RelativeLayout>

    <!-- <RelativeLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_below="@+id/bottomLay"
         >

     <Button
         android:id="@+id/go_to_picker_button"
         android:layout_width="100dp"
         android:layout_height="100dp"
         android:visibility="invisible"
         android:backgroundTint="@color/secondaryText"
         android:background="@color/secondaryText"
         android:text="@string/go_to_picker_activity" />

     <TextView
         android:id="@+id/selected_location_info_textview"
         android:layout_width="match_parent"
         android:layout_height="match_parent" />
     </RelativeLayout>-->


</RelativeLayout>